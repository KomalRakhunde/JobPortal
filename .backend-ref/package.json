    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.4",
    "pg": "^8.22.0",
